
{% extends "base.html" %}

{% block titulo %}Cambiar contraseña{% endblock %}

{% block contenido %}
<div class="page-heading">
    <div>
        <span class="breadcrumb">Mi cuenta / Seguridad</span>
        <h1>Cambiar contraseña</h1>
        <p>
            Actualiza la contraseña de tu cuenta personal.
        </p>
    </div>
</div>

<section class="panel feature-panel">
    <form method="post">
        {% csrf_token %}

        {% if formulario.non_field_errors %}
            <div class="message error">
                {{ formulario.non_field_errors }}
            </div>
        {% endif %}

        {% for campo in formulario %}
            <div class="form-group">
                <label for="{{ campo.id_for_label }}">
                    {{ campo.label }}
                </label>

                {{ campo }}

                {% if campo.help_text %}
                    <small>{{ campo.help_text|safe }}</small>
                {% endif %}

                {% for error in campo.errors %}
                    <p class="message error">{{ error }}</p>
                {% endfor %}
            </div>
        {% endfor %}

        <div class="quick-links">
            <button class="button primary" type="submit">
                Actualizar contraseña
            </button>

            <a class="button outline" href="{% url 'perfil' %}">
                Volver al perfil
            </a>
        </div>
    </form>
</section>
{% endblock %}
